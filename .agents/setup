#!/usr/bin/env bash
set -euo pipefail

NODE_VERSION=22.19.0
temp_dir=

cleanup() {
  [ -z "$temp_dir" ] || rm -rf "$temp_dir"
}
trap cleanup EXIT

echo "Installing system prerequisites..."
sudo apt-get update
sudo apt-get install -y --no-install-recommends \
  build-essential ca-certificates curl git pkg-config python3 xz-utils tmux zsh

if ! node -e "const [a,b]=process.versions.node.split('.').map(Number); process.exit(a > 22 || (a === 22 && b >= 19) ? 0 : 1)" 2>/dev/null; then
  case "$(uname -m)" in
    x86_64) node_arch=x64 ;;
    aarch64|arm64) node_arch=arm64 ;;
    *) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;;
  esac
  echo "Installing Node.js ${NODE_VERSION}..."
  archive="node-v${NODE_VERSION}-linux-${node_arch}.tar.xz"
  temp_dir="$(mktemp -d)"
  curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/${archive}" -o "${temp_dir}/${archive}"
  sudo tar -xJf "${temp_dir}/${archive}" -C /usr/local --strip-components=1
  hash -r
fi

echo "Using Node.js $(node --version) and npm $(npm --version)"

# Oh My Pi (omp) — needed for the OMP harness integration and its canaries.
# The npm package requires Bun >= 1.3.14 to parse its bundled CLI.
BUN_MIN_VERSION=1.3.14
bun_ok() {
  bun --version 2>/dev/null | awk -F. -v maj=1 -v min=3 -v pat=14 \
    '{ exit !($1 > maj || ($1 == maj && ($2 > min || ($2 == min && $3 >= pat)))) }'
}
if ! bun_ok; then
  if command -v bun >/dev/null 2>&1; then
    echo "Upgrading Bun to >= ${BUN_MIN_VERSION}..."
    sudo npm install --global "bun@${BUN_MIN_VERSION}"
  else
    echo "Installing Bun..."
    sudo npm install --global "bun@${BUN_MIN_VERSION}"
  fi
fi
bun_ok || { echo "Bun >= ${BUN_MIN_VERSION} required, got $(bun --version)" >&2; exit 1; }
echo "Using Bun $(bun --version)"

echo "Installing Oh My Pi (omp)..."
sudo npm install --global @oh-my-pi/pi-coding-agent@18.1.15
omp --version
# Provider credentials (e.g. ZAI_API_KEY) belong in ~/.omp/agent/.env,
# written per-orb at runtime — never committed to this repository.

echo "Installing repository dependencies..."
npm ci

echo "Installing the repository-pinned Chromium and OS dependencies..."
npx playwright install --with-deps chromium

echo "Orb setup complete."
