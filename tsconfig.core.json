{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src/core",
    "outDir": "lib",
    "strict": true,
    "noEmitOnError": true,
    "declaration": true,
    "newLine": "lf",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/core/**/*.ts"]
}
