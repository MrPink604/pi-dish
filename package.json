{
  "name": "pi-dish",
  "version": "1.0.0",
  "description": "Web/phone remote control for pi coding-agent sessions",
  "license": "0BSD",
  "main": "server.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node scripts/run-tests.js",
    "test:lineage": "node scripts/test-real-lineage-harnesses.js",
    "build:vendor": "node scripts/build-vendor.js",
    "build:core": "node scripts/build-core.js",
    "electron:dev": "electron electron/main.js",
    "electron:build": "electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "test:ui": "node test/ui-smoke.js",
    "shots": "node scripts/readme-shots.js",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium",
    "test:ui:scenarios": "node scripts/run-ui-scenarios.js",
    "lint": "eslint .",
    "typecheck": "node scripts/build-core.js --check && tsc -p tsconfig.check.json",
    "check": "npm run lint && npm run typecheck"
  },
  "build": {
    "appId": "com.pidish.app",
    "productName": "pi-dish",
    "files": [
      "server.js",
      "lib/**/*",
      "public/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    }
  },
  "author": {
    "name": "MrPink604",
    "email": "pi-dish@localhost"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-server": "^0.85.0",
    "@ff-labs/fff-node": "^0.9.6",
    "compression": "^1.8.1",
    "express": "^4.18.2",
    "highlight.js": "^11.9.0",
    "katex": "^0.18.4",
    "marked": "^12.0.1",
    "node-pty": "^1.1.0",
    "ws": "^8.21.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "10.10.0",
    "espree": "11.2.0",
    "globals": "17.6.0",
    "mermaid": "^11.17.2",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
