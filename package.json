{
  "name": "pi-dish",
  "version": "1.0.0",
  "description": "Web/phone remote control for pi coding-agent sessions",
  "license": "0BSD",
  "main": "server.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node scripts/run-tests.js",
    "test:lineage": "node scripts/test-real-lineage-harnesses.js",
    "build:vendor": "node scripts/build-vendor.js",
    "build:core": "node scripts/build-core.js",
    "build:edges": "node scripts/build-edges.js",
    "test:ui": "node test/ui-smoke.js",
    "shots": "node scripts/readme-shots.js",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium",
    "test:ui:scenarios": "node scripts/run-ui-scenarios.js",
    "lint": "eslint .",
    "typecheck": "node scripts/build-tools.js --check && node scripts/build-tests.js --check && node scripts/build-core.js --check && node scripts/build-browser.js --check && node scripts/build-edges.js --check && node scripts/build-vendor.js --check && tsc -p tsconfig.extensions.json && tsc -p tsconfig.helpers.json && tsc -p tsconfig.check.json && tsc -p tsconfig.configs.json",
    "check": "npm run check:source-policy && npm run lint && npm run typecheck",
    "build:browser": "node scripts/build-browser.js",
    "check:source-policy": "node scripts/check-source-policy.mjs",
    "build:tools": "node scripts/build-tools.js",
    "build:tests": "node scripts/build-tests.js"
  },

  "author": {
    "name": "MrPink604",
    "email": "pi-dish@localhost"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-server": "^0.85.0",
    "@ff-labs/fff-node": "^0.9.6",
    "compression": "^1.8.1",
    "esbuild": "0.28.1",
    "express": "^4.18.2",
    "highlight.js": "^11.9.0",
    "katex": "^0.18.4",
    "marked": "^12.0.1",
    "node-pty": "^1.1.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "0.85.1",
    "@playwright/test": "1.63.0",
    "@types/compression": "1.8.1",
    "@types/express": "4.17.25",
    "@types/katex": "0.16.8",
    "@types/node": "22.20.2",
    "@types/proper-lockfile": "4.1.4",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.1",
    "@xmldom/xmldom": "0.8.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "eslint": "10.10.0",
    "espree": "11.2.0",
    "globals": "17.6.0",
    "mermaid": "^11.17.2",
    "typebox": "1.3.7",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
