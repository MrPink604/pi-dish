{
  "name": "pi-dish",
  "version": "1.0.0",
  "description": "Web/phone remote control for pi coding-agent sessions",
  "license": "0BSD",
  "main": "server.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node scripts/run-tests.js",
    "test:lineage": "node scripts/test-real-lineage-harnesses.js",
    "build:vendor": "node scripts/build-vendor.js",
    "build:core": "node scripts/build-core.js",
    "build:edges": "node scripts/build-edges.js",
    "electron:dev": "electron electron/main.js",
    "electron:build": "electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "test:ui": "node test/ui-smoke.js",
    "shots": "node scripts/readme-shots.js",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium",
    "test:ui:scenarios": "node scripts/run-ui-scenarios.js",
    "lint": "eslint .",
    "typecheck": "node scripts/build-tools.js --check && node scripts/build-tests.js --check && node scripts/build-core.js --check && node scripts/build-browser.js --check && node scripts/build-edges.js --check && tsc -p tsconfig.extensions.json && tsc -p tsconfig.helpers.json && tsc -p tsconfig.check.json && tsc -p tsconfig.configs.json",
    "check": "npm run check:source-policy && npm run lint && npm run typecheck",
    "build:browser": "node scripts/build-browser.js",
    "check:source-policy": "node scripts/check-source-policy.mjs",
    "build:tools": "node scripts/build-tools.js",
    "build:tests": "node scripts/build-tests.js"
  },
  "build": {
    "appId": "com.pidish.app",
    "productName": "pi-dish",
    "files": [
      "server.js",
      "lib/*.js",
      "public/**/*",
      "electron/main.js",
      "extensions/pi-dish-bridge/package.json",
      "extensions/pi-dish-bridge/core.ts",
      "extensions/pi-dish-bridge/index.ts",
      "extensions/pi-dish-bridge/pi-private.ts",
      "extensions/pi-dish-bridge-omp/index.ts",
      "extensions/pi-dish-bridge-omp/native-state.ts",
      "extensions/pi-dish-bridge-prime/index.ts",
      "extensions/mood.ts",
      "extensions/pi-dish-share-omp.mjs",
      "skills/lib/pi-dish-client.js",
      "skills/pi-dish-sessions/scripts/pi-dish-sessions.js",
      "skills/pi-dish-comments/scripts/pi-dish-comments.js",
      "skills/pi-dish-pages/scripts/pi-dish-pages.js",
      "skills/*/SKILL.md",
      "skills/*/agents/**/*",
      "skills/*/references/**/*",
      "docs/agent/*.md",
      "!src/**/*",
      "!test/**/*",
      "!scripts/**/*",
      "!tsconfig*.json",
      "!source-policy.json",
      "!eslint.config.js",
      "!playwright.config.ts",
      "!skills/**/*.ts",
      "!electron/**/*.ts",
      "!extensions/pi-dish-share-omp.mts",
      "!**/*.d.ts",
      "!**/*.d.mts",
      "!**/*.map"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "asar": true,
    "asarUnpack": [
      "lib/*.js",
      "extensions/**/*",
      "skills/**/*",
      "node_modules/@ff-labs/fff-node/**/*",
      "node_modules/@ff-labs/fff-bin-*/**/*",
      "node_modules/ffi-rs/**/*",
      "node_modules/@yuuang/ffi-rs-*/**/*",
      "**/*.node",
      "**/*.so"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    }
  },
  "author": {
    "name": "MrPink604",
    "email": "pi-dish@localhost"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-server": "^0.85.0",
    "@ff-labs/fff-node": "^0.9.6",
    "compression": "^1.8.1",
    "express": "^4.18.2",
    "highlight.js": "^11.9.0",
    "katex": "^0.18.4",
    "marked": "^12.0.1",
    "node-pty": "^1.1.0",
    "ws": "^8.21.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "0.85.1",
    "@playwright/test": "1.63.0",
    "@types/compression": "1.8.1",
    "@types/express": "4.17.25",
    "@types/katex": "0.16.8",
    "@types/node": "22.20.2",
    "@types/proper-lockfile": "4.1.4",
    "@types/ws": "8.18.1",
    "@xmldom/xmldom": "0.8.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "eslint": "10.10.0",
    "espree": "11.2.0",
    "globals": "17.6.0",
    "mermaid": "^11.17.2",
    "typebox": "1.3.7",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
